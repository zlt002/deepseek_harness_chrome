@@ -0,0 +1,43 @@
+/** Product-extensible labels for the existing permission controls. */
+export type PermissionLabelResolver = (value: string, fallback: string) => string | undefined
+
+/**
+ * Small registry rather than a locale table: permission presets are host
+ * supplied, while a product may know a stable subset that deserves its own
+ * presentation copy. Resolvers decline unknown values so the official label
+ * remains the safe fallback.
+ */
+export class PermissionLabelRegistry {
+  private readonly resolvers = new Set<PermissionLabelResolver>()
+  private readonly listeners = new Set<() => void>()
+  private revision = 0
+
+  readonly subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  readonly getSnapshot = (): number => this.revision
+
+  register(resolver: PermissionLabelResolver): () => void {
+    this.resolvers.add(resolver)
+    this.changed()
+    return () => {
+      if (!this.resolvers.delete(resolver)) return
+      this.changed()
+    }
+  }
+
+  resolve(value: string, fallback: string): string {
+    for (const resolver of [...this.resolvers].reverse()) {
+      const label = resolver(value, fallback)
+      if (label !== undefined) return label
+    }
+    return fallback
+  }
+
+  private changed(): void {
+    this.revision += 1
+    for (const listener of this.listeners) listener()
+  }
+}
