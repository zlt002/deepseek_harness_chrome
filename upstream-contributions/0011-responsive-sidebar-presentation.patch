+
+/** Narrow side-panel state remains in the shell; products only render the supplied owner. */
+function CompactSidebarRoot({ startSession, t, renderSlot, renderSlotChain, useSessions, useView }: SidebarRootComponentProps) {
+  const currentAddress = useSessions(state => state.currentAddress)
+  const currentSessionId = useSessions(state => state.current)
+  const view = useView(state => state)
+  const regularTitle = useSessions(state => currentSessionId === undefined
+    ? undefined
+    : state.byId[currentSessionId]?.displayTitle ?? currentSessionId)
+  const subagentSessionId = currentAddress?.childSessionId === currentSessionId
+    ? currentSessionId
+    : undefined
+  const subagentTitle = useSessions(state => subagentSessionId === undefined
+    ? undefined
+    : state.byId[subagentSessionId]?.displayTitle ?? subagentSessionId)
+
+  const owner: SidebarCompactPresentationOwnerProps = {
+    mode: subagentSessionId !== undefined && currentAddress !== undefined
+      ? 'subagent'
+      : view === 'trajectory' && currentSessionId !== undefined ? 'trajectory' : 'standard',
+    title: subagentSessionId !== undefined ? subagentTitle : regularTitle,
+    sessionId: subagentSessionId ?? currentSessionId,
+    parentSessionId: subagentSessionId === undefined ? undefined : currentAddress?.parentSessionId,
+    startSession,
+    renderWorkspace: () => renderSlot('sidebar.workspaces', { wide: false, compact: true, expandSidebar: () => {} }),
+    renderActions: () => renderSlot('sidebar.compact.action', {}),
+    renderSettings: () => renderSlot('sidebar.settings', { wide: false, compact: true }),
+    renderDetailActions: () => subagentSessionId !== undefined && currentAddress !== undefined
+      ? renderSlot('sidebar.compact.subagent.action', { sessionId: subagentSessionId, parentSessionId: currentAddress.parentSessionId })
+      : currentSessionId === undefined ? null : renderSlot('sidebar.compact.trajectory.action', { sessionId: currentSessionId }),
+    t,
+  }
+  return <>{renderSlotChain('sidebar.compact.presentation', owner, { fallback: <OfficialCompactSidebar owner={owner} /> })}</>
+}
+
+export function SidebarRoot(props: SidebarRootComponentProps) {
+  return props.presentation === 'compact'
+    ? <CompactSidebarRoot {...props} />
+    : <ColumnSidebarRoot {...props} />
+}
