+const IMAGE_MEDIA_TYPES = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif'])
+const IMAGE_NAME_PATTERN = /\.(?:png|jpe?g|webp|gif)$/i
+
+/** True when the browser file is admitted by the official image rail. */
+function isComposerImageFile(file: File): boolean {
+  return IMAGE_MEDIA_TYPES.has(file.type) || IMAGE_NAME_PATTERN.test(file.name)
+}
+
+function composerFileIntakeOf(ctx: Context): ComposerFileIntake | undefined {
+  const intake = ctx.get('composerFileIntake')
+  if (intake === undefined || typeof intake.accept !== 'function') return undefined
+  return intake as ComposerFileIntake
+}
