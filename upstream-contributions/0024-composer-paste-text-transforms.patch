diff --git a/packages/client/ui-conversation/src/client/input/paste-text-transforms.ts b/packages/client/ui-conversation/src/client/input/paste-text-transforms.ts
new file mode 100644
index 0000000000..0b141fa37a
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/input/paste-text-transforms.ts
@@ -0,0 +1,31 @@
+/** One product-neutral transformation performed before text enters the composer machine. */
+export interface ComposerPasteTextTransform {
+  /** Stable registry key; duplicate keys are rejected. */
+  readonly id: string
+  /** Return the plain text that the composer should paste. */
+  transform(text: string): string
+}
+
+/** Ordered registry for independent text-only composer paste transformations. */
+export class ComposerPasteTextTransforms {
+  private readonly transforms = new Map<string, ComposerPasteTextTransform>()
+
+  register(transform: ComposerPasteTextTransform): () => void {
+    if (this.transforms.has(transform.id)) {
+      throw new Error(`composer paste text transform already registered: ${transform.id}`)
+    }
+    this.transforms.set(transform.id, transform)
+    let active = true
+    return () => {
+      if (!active) return
+      active = false
+      this.transforms.delete(transform.id)
+    }
+  }
+
+  transform(text: string): string {
+    let current = text
+    for (const transform of this.transforms.values()) current = transform.transform(current)
+    return current
+  }
+}
