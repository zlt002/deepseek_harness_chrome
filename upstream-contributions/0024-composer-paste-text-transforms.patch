index 0000000000..15c33da54b
--- /dev/null
+++ b/packages/client/ui-conversation/tests/paste-text-transforms.client.spec.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest'
+import { ComposerPasteTextTransforms } from '../src/client/input/paste-text-transforms.ts'
+
+describe('ComposerPasteTextTransforms', () => {
+  it('composes transforms in registration order', () => {
+    const transforms = new ComposerPasteTextTransforms()
+    transforms.register({ id: 'first', transform: text => `${text} A` })
+    transforms.register({ id: 'second', transform: text => `${text} B` })
+    expect(transforms.transform('paste')).toBe('paste A B')
+  })
+
+  it('rejects duplicate transform identities and removes disposed transforms', () => {
+    const transforms = new ComposerPasteTextTransforms()
+    const stop = transforms.register({ id: 'same', transform: text => `${text}!` })
+    expect(() => transforms.register({ id: 'same', transform: text => text })).toThrow('same')
+    stop()
+    expect(transforms.transform('paste')).toBe('paste')
+  })
+})
