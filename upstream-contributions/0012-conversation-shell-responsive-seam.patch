diff --git a/packages/client/ui-conversation/src/client/view-state.ts b/packages/client/ui-conversation/src/client/view-state.ts
new file mode 100644
index 0000000..c37e2c6
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/view-state.ts
@@ -0,0 +1,140 @@
+/** Read-only bridge from a session chat store to root-scoped view controls. */
+import type { SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+import type { HostObservable, StoreInstance } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ChatStoreState } from './contract/views.ts'
+
+type ChatActions = {
+  setView: (view: string) => void
+}
+
+type ChatStoreInstance = StoreInstance<ChatStoreState, {
+  setView: (draft: ChatStoreState, view: string) => void
+}>
+
+/** One session's live view source; it always reads the authoritative chat store. */
+class SessionViewSource implements HostObservable<string | null> {
+  private instance: ChatStoreInstance | undefined
+  private unsubscribe: (() => void) | undefined
+  private readonly listeners = new Set<() => void>()
+
+  attach(instance: ChatStoreInstance): void {
+    this.unsubscribe?.()
+    this.instance = instance
+    this.unsubscribe = instance.subscribe(() => { this.emit() })
+    this.emit()
+  }
+
+  getSnapshot(): string | null {
+    return this.instance?.getSnapshot().view ?? null
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  setView(view: string): void {
+    (this.instance?.actions as ChatActions | undefined)?.setView(view)
+  }
+
+  dispose(): void {
+    this.unsubscribe?.()
+    this.unsubscribe = undefined
+    this.instance = undefined
+    this.listeners.clear()
+  }
+
+  private emit(): void {
+    for (const listener of this.listeners) listener()
+  }
+}
+
+/** Tracks the selected session without copying its view state. */
+class CurrentSessionViewSource implements HostObservable<string | null> {
+  private current: SessionViewSource | undefined
+  private unsubscribeCurrent: (() => void) | undefined
+  private readonly listeners = new Set<() => void>()
+  private readonly unsubscribeSessions: () => void
+
+  constructor(
+    private readonly owner: ConversationViewState,
+    private readonly sessions: HostObservable<{ readonly current: SessionId | undefined }>,
+  ) {
+    this.unsubscribeSessions = sessions.subscribe(() => { this.rebind() })
+    this.rebind()
+  }
+
+  getSnapshot(): string | null {
+    return this.current?.getSnapshot() ?? null
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  dispose(): void {
+    this.unsubscribeSessions()
+    this.unsubscribeCurrent?.()
+    this.listeners.clear()
+  }
+
+  private rebind(): void {
+    const sessionId = this.sessions.getSnapshot().current
+    const next = sessionId === undefined ? undefined : this.owner.sessionSource(sessionId)
+    if (next === this.current) return
+    this.unsubscribeCurrent?.()
+    this.current = next
+    this.unsubscribeCurrent = next?.subscribe(() => { this.emit() })
+    this.emit()
+  }
+
+  private emit(): void {
+    for (const listener of this.listeners) listener()
+  }
+}
+
+/**
+ * Cross-surface view bridge. It holds no view state: each source subscribes
+ * directly to the existing per-session chat store owned by the slot runtime.
+ */
+export class ConversationViewState {
+  private readonly sources = new Map<SessionId, SessionViewSource>()
+  private current: CurrentSessionViewSource | undefined
+
+  sourceFor(sessionId: SessionId): HostObservable<string | null> {
+    return this.sessionSource(sessionId)
+  }
+
+  /** Root-scoped consumers follow the selected session's already-owned store. */
+  currentSource(sessions: HostObservable<{ readonly current: SessionId | undefined }>): HostObservable<string | null> {
+    this.current ??= new CurrentSessionViewSource(this, sessions)
+    return this.current
+  }
+
+  sessionSource(sessionId: SessionId): SessionViewSource {
+    let source = this.sources.get(sessionId)
+    if (source === undefined) {
+      source = new SessionViewSource()
+      this.sources.set(sessionId, source)
+    }
+    return source
+  }
+
+  attach(sessionId: SessionId, instance: ChatStoreInstance): void {
+    const source = this.sourceFor(sessionId) as SessionViewSource
+    source.attach(instance)
+  }
+
+  setView(sessionId: SessionId, view: string): void {
+    const source = this.sources.get(sessionId)
+    source?.setView(view)
+  }
+
+  dispose(): void {
+    this.current?.dispose()
+    this.current = undefined
+    for (const source of this.sources.values()) source.dispose()
+    this.sources.clear()
+  }
+}

