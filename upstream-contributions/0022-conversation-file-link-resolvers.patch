+/** Ordered, composable providers for closed-assistant file mentions. */
+export class ChatFileMentionRegistry implements ChatFileMentionProvider {
+  readonly #providers = new Set<ChatFileMentionProvider>()
+
+  register(provider: ChatFileMentionProvider): () => void {
+    this.#providers.add(provider)
+    return () => { this.#providers.delete(provider) }
+  }
+
+  forClosing(owner: TurnTailOwnerProps): MarkdownFileMentions | undefined {
+    const mentions = [...this.#providers].reverse().map(provider => provider.forClosing(owner)).filter((value): value is MarkdownFileMentions => value !== undefined)
+    if (mentions.length === 0) return undefined
+    return {
+      resolve: value => mentions.map(mention => mention.resolve(value)).find(mention => mention !== undefined),
+      resolveLink: href => mentions.map(mention => mention.resolveLink?.(href)).find(mention => mention !== undefined),
+    }
+  }
+}
+
