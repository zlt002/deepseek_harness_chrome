diff --git a/packages/client/ui-primitives/src/ComposerOverlay.tsx b/packages/client/ui-primitives/src/ComposerOverlay.tsx
new file mode 100644
index 0000000000..d76433b6ef
--- /dev/null
+++ b/packages/client/ui-primitives/src/ComposerOverlay.tsx
@@ -0,0 +1,82 @@
+/** One card-wide upward panel at a time for composer controls. */
+import { createContext, useCallback, useContext, useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react'
+import type { ReactNode } from 'react'
+
+type OverlayRender = () => ReactNode
+
+interface ComposerOverlayApi {
+  register(id: string, render: OverlayRender): () => void
+  toggle(id: string): void
+  show(id: string): void
+  close(id?: string): void
+  refresh(id: string): void
+}
+
+const ApiContext = createContext<ComposerOverlayApi | null>(null)
+const ActiveContext = createContext<string | null>(null)
+const ContentContext = createContext<ReactNode>(null)
+
+export function ComposerOverlayProvider({ children }: { children: ReactNode }) {
+  const entries = useRef(new Map<string, OverlayRender>())
+  const [active, setActive] = useState<string | null>(null)
+  const [, setRevision] = useState(0)
+  const register = useCallback((id: string, render: OverlayRender) => {
+    entries.current.set(id, render)
+    setRevision(value => value + 1)
+    return () => {
+      entries.current.delete(id)
+      setRevision(value => value + 1)
+      setActive(current => current === id ? null : current)
+    }
+  }, [])
+  const api = useMemo<ComposerOverlayApi>(() => ({
+    register,
+    toggle: (id) => { setActive(current => current === id ? null : id) },
+    show: (id) => { setActive(id) },
+    close: (id) => { setActive(current => id === undefined || current === id ? null : current) },
+    refresh: () => { setRevision(value => value + 1) },
+  }), [register])
+  useEffect(() => {
+    if (active === null) return
+    const closeOutside = (event: PointerEvent): void => {
+      if (!(event.target instanceof Element)) return
+      if (event.target.closest('[data-composer-overlay-surface], [data-composer-overlay-trigger]') !== null) return
+      setActive(null)
+    }
+    const closeEscape = (event: KeyboardEvent): void => {
+      if (event.key === 'Escape') setActive(null)
+    }
+    document.addEventListener('pointerdown', closeOutside, true)
+    document.addEventListener('keydown', closeEscape)
+    return () => { document.removeEventListener('pointerdown', closeOutside, true); document.removeEventListener('keydown', closeEscape) }
+  }, [active])
+  const content = active === null ? null : entries.current.get(active)?.() ?? null
+  return <ApiContext.Provider value={api}><ActiveContext.Provider value={active}><ContentContext.Provider value={content}>{children}</ContentContext.Provider></ActiveContext.Provider></ApiContext.Provider>
+}
+
+/** Register a card-wide panel without moving it out of the composer card. */
+export function useComposerOverlay(id: string, panel?: ReactNode | (() => ReactNode)) {
+  const api = useContext(ApiContext)
+  const active = useContext(ActiveContext)
+  const panelRef = useRef(panel)
+  panelRef.current = panel
+  useEffect(() => api === null || panel === undefined ? undefined : api.register(id, () => {
+    const current = panelRef.current
+    return typeof current === 'function' ? current() : current
+  }), [api, id, panel === undefined])
+  useLayoutEffect(() => {
+    if (active === id) api?.refresh(id)
+  })
+  return {
+    available: api !== null,
+    open: active === id,
+    toggle: () => { api?.toggle(id) },
+    show: () => { api?.show(id) },
+    close: () => { api?.close(id) },
+  }
+}
+
+/** Render the active registered panel at the owning card's full-width anchor. */
+export function ComposerOverlaySurface() {
+  return <div data-composer-overlay-surface>{useContext(ContentContext)}</div>
+}
