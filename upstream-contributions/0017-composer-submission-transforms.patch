diff --git a/packages/client/ui-conversation/src/client/input/submission-transforms.ts b/packages/client/ui-conversation/src/client/input/submission-transforms.ts
new file mode 100644
index 0000000..7f19b2e
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/input/submission-transforms.ts
@@ -0,0 +1,43 @@
+import type { SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+
+/** One product-neutral transformation performed immediately before prompt delivery. */
+export interface ComposerSubmissionTransform {
+  /** Stable registry key; duplicate keys are rejected. */
+  readonly id: string
+  /** Return the text that should enter the ordinary conversation send path. */
+  prepare(sessionId: SessionId, text: string): ComposerSubmissionPreparation
+}
+
+/** One transformed prompt plus the exact successful-delivery acknowledgement. */
+export interface ComposerSubmissionPreparation {
+  readonly text: string
+  /** Runs only after the host has accepted the transformed prompt. */
+  readonly accept?: () => void
+}
+
+/** Registry for independently owned prompt enrichments at the composer boundary. */
+export class ComposerSubmissionTransforms {
+  private readonly transforms = new Map<string, ComposerSubmissionTransform>()
+
+  register(transform: ComposerSubmissionTransform): () => void {
+    if (this.transforms.has(transform.id)) {
+      throw new Error(`composer submission transform already registered: ${transform.id}`)
+    }
+    this.transforms.set(transform.id, transform)
+    return () => { this.transforms.delete(transform.id) }
+  }
+
+  prepare(sessionId: SessionId, text: string): ComposerSubmissionPreparation {
+    let current = text
+    const accepted: (() => void)[] = []
+    for (const transform of this.transforms.values()) {
+      const next = transform.prepare(sessionId, current)
+      current = next.text
+      if (next.accept !== undefined) accepted.push(next.accept)
+    }
+    return {
+      text: current,
+      ...(accepted.length === 0 ? {} : { accept: () => { for (const acknowledge of accepted) acknowledge() } }),
+    }
+  }
+}
diff --git a/packages/client/ui-conversation/tests/submission-transforms.client.spec.ts b/packages/client/ui-conversation/tests/submission-transforms.client.spec.ts
new file mode 100644
index 0000000..88a2025
--- /dev/null
+++ b/packages/client/ui-conversation/tests/submission-transforms.client.spec.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest'
+import { ComposerSubmissionTransforms } from '../src/client/input/submission-transforms.ts'
+
+describe('ComposerSubmissionTransforms', () => {
+  it('composes transforms in registration order and acknowledges only after acceptance', () => {
+    const transforms = new ComposerSubmissionTransforms()
+    const accepted: string[] = []
+    transforms.register({ id: 'first', prepare: (_session, text) => ({ text: `${text} A`, accept: () => { accepted.push('first') } }) })
+    transforms.register({ id: 'second', prepare: (_session, text) => ({ text: `${text} B`, accept: () => { accepted.push('second') } }) })
+    const prepared = transforms.prepare('session-1' as never, 'prompt')
+    expect(prepared.text).toBe('prompt A B')
+    expect(accepted).toEqual([])
+    prepared.accept?.()
+    expect(accepted).toEqual(['first', 'second'])
+  })
+
+  it('rejects duplicate transform identities', () => {
+    const transforms = new ComposerSubmissionTransforms()
+    transforms.register({ id: 'same', prepare: (_session, text) => ({ text }) })
+    expect(() => transforms.register({ id: 'same', prepare: (_session, text) => ({ text }) })).toThrow('same')
+  })
+})
