+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import type { ReactNode } from 'react'
+import type { RunningToolCall, SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+import type { ToolCallOwnerProps, ToolTreeProps } from '../src/client/contract/slots.ts'
+import { ToolCallTree } from '../src/client/tool/ToolCallTree.tsx'
+
+afterEach(cleanup)
+
+const t = ((key: string) => key) as never
+
+function call(toolName: string, path: string): RunningToolCall {
+  return {
+    callId: 'call-1', name: toolName, argsRaw: JSON.stringify(toolName === 'read' ? { path } : { file_path: path }),
+    turn: 1, step: 1, time: 1_000, callView: null, subCalls: [],
+  }
+}
+
+function renderToolPath(toolName: string, path: string, resolver: (path: string) => { open(): void } | undefined) {
+  const openFile = vi.fn()
+  const inspectCall = vi.fn()
+  const root = call(toolName, path)
+  const renderSlot = ((_name: string, owner: ToolCallOwnerProps, { fallback }: { fallback: ReactNode }) => {
+    if (owner.toolName === 'read' || owner.toolName === 'edit' || owner.toolName === 'write') {
+      return <button type="button" onClick={() => { owner.openFile(path) }}>{path}</button>
+    }
+    return fallback
+  }) as unknown as ToolTreeProps['renderSlot']
+  const props = {
+    renderSlot,
+    node: { data: { root } },
+    sessionId: 'session-1' as SessionId,
+    selectedCallId: undefined,
+    cwd: '/workspace',
+    openFile,
+    inspectCall,
+    t,
+    toolFileLinks: { resolve: (_owner: unknown, value: string) => resolver(value) },
+  } as unknown as ToolTreeProps & { toolFileLinks: { resolve(owner: ToolCallOwnerProps, path: string): { open(): void } | undefined } }
+  const view = render(
+    <ToolCallTree
+      {...props}
+    />,
+  )
+  return { ...view, openFile, inspectCall }
+}
+
+describe('ToolCallTree file paths', () => {
+  it.each([
+    ['edit', 'spec/process.md'],
+    ['write', 'spec/output.markdown'],
+    ['read', 'README.md'],
+  ])('%s Markdown paths are claimed without opening the Host or details', (toolName, path) => {
+    const review = vi.fn()
+    const view = renderToolPath(toolName, path, value => value.endsWith('.md') || value.endsWith('.markdown') ? { open: review } : undefined)
+
+    fireEvent.click(view.getByText(path))
+
+    expect(review).toHaveBeenCalledOnce()
+    expect(view.openFile).not.toHaveBeenCalled()
+    expect(view.inspectCall).not.toHaveBeenCalled()
+    expect(view.container.querySelector('[aria-expanded="true"]')).toBeNull()
+  })
+
+  it('leaves an unclaimed path on the Host opener', () => {
+    const view = renderToolPath('edit', 'spec/notes.txt', () => undefined)
+
+    fireEvent.click(view.getByText('spec/notes.txt'))
+
+    expect(view.openFile).toHaveBeenCalledWith('spec/notes.txt')
+    expect(view.inspectCall).not.toHaveBeenCalled()
+    expect(view.container.querySelector('[aria-expanded="true"]')).toBeNull()
+  })
+})
