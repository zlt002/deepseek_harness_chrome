+/** A resolver-owned action for a Tool argument path. */
+export interface ToolFileLink {
+  open(): void
+}
+
+/** Optional handler for Tool argument paths before the Host fallback. */
+export interface ToolFileLinkProvider {
+  resolve(owner: ToolCallOwnerProps, path: string): ToolFileLink | undefined
+}
+
+/** Ordered, composable providers for Tool argument paths. */
+export class ToolFileLinkRegistry implements ToolFileLinkProvider {
+  readonly #providers = new Set<ToolFileLinkProvider>()
+
+  register(provider: ToolFileLinkProvider): () => void {
+    this.#providers.add(provider)
+    return () => { this.#providers.delete(provider) }
+  }
+
+  resolve(owner: ToolCallOwnerProps, path: string): ToolFileLink | undefined {
+    return [...this.#providers].reverse()
+      .map(provider => provider.resolve(owner, path))
+      .find((link): link is ToolFileLink => link !== undefined)
+  }
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Composable Tool argument-path registry. */
+    toolFileLinks: ToolFileLinkRegistry
+  }
+}
+
 /** Standard owner currency supplied to every atomic Tool view. */
 export interface ToolCallOwnerProps {
+  /** Session that owns this Tool call when rendered through a session tree. */
+  sessionId?: SessionId | undefined
   /** Tool call identity, stable across running and settled forms. */
   callId: string
   /** Wire Tool name and keyed dispatch value. */
