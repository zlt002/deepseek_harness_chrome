@@ -0,0 +1,37 @@
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+
+export interface Scope { domainId: string; systemIds: string[]; repositoryIds: string[] }
+export interface Catalog { domains: Array<{ id: string; name: string }>; systems: Array<{ id: string; name: string }>; repositories: Array<{ id: string; name: string }> }
+export interface Snapshot { sessionId: string; scope?: Scope; catalog: Catalog; error?: string }
+
+function validSnapshot(value: unknown): value is Snapshot {
+  const item = value as Partial<Snapshot> | undefined
+  return !!item && typeof item.sessionId === 'string' && !!item.catalog && Array.isArray(item.catalog.domains) && Array.isArray(item.catalog.systems) && Array.isArray(item.catalog.repositories)
+}
+
+/** Nonce- and origin-checked channel between the loopback iframe and its extension owner. */
+export function createKnowledgeScopeBridge(nonce: string, parentOrigin: string): { source: SnapshotStore<Snapshot | undefined>; request: (sessionId: string, scope?: Scope) => void; accept: (event: Pick<MessageEvent, 'source' | 'origin' | 'data'>, parent: WindowProxy) => boolean } {
+  const source = createSnapshotStore<Snapshot | undefined>(undefined)
+  let incoming = 0; let outgoing = 0
+  return {
+    source,
+    request(sessionId, scope) {
+      outgoing += 1
+      window.parent.postMessage({ type: 'knowledge-scope-command/v1', nonce, sequence: outgoing, sessionId, ...(scope === undefined ? {} : { scope }) }, parentOrigin)
+    },
+    accept(event, parent) {
+      if (event.source !== parent || event.origin !== parentOrigin || !event.data || typeof event.data !== 'object') return false
+      const message = event.data as { type?: unknown; nonce?: unknown; sequence?: unknown; snapshot?: unknown }
+      if (message.type !== 'knowledge-scope-snapshot/v1' || message.nonce !== nonce || typeof message.sequence !== 'number' || message.sequence <= incoming || !validSnapshot(message.snapshot)) return false
+      incoming = message.sequence; source.set(message.snapshot); return true
+    },
+  }
+}
+
+export function knowledgeScopeBridgeConfig(location: Location = window.location): { nonce: string; parentOrigin: string } | undefined {
+  const query = new URLSearchParams(location.search)
+  if (query.get('dshBrowserTargetBridge') !== '1') return undefined
+  const nonce = query.get('dshBrowserTargetNonce'); const parentOrigin = query.get('dshBrowserTargetParentOrigin')
+  if (nonce === null || parentOrigin === null) return undefined
+  try { const parsed = new URL(parentOrigin); return parsed.protocol === 'chrome-extension:' && `${parsed.protocol}//${parsed.host}` === parentOrigin ? { nonce, parentOrigin } : undefined } catch { return undefined }
+}
