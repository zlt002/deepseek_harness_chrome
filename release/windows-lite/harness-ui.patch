+/** Package-owned invariant companion for the read-only active-tab dock. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-client-ui-browser-target'
+
+export const name = 'client-ui-browser-target-invariant'
+export const inject = ['invariants']
+
+// No runtime invariant: the source has no Cordis event or mutable service relation;
+// its nonce, parent-origin, source-window, and sequence rules are wire validation.
+const install: InvariantInstaller = () => {}
+
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
diff --git a/packages/client/ui-browser-target/tests/active-tab-bridge.client.spec.ts b/packages/client/ui-browser-target/tests/active-tab-bridge.client.spec.ts
new file mode 100644
index 0000000000..800ff5a6d7
--- /dev/null
+++ b/packages/client/ui-browser-target/tests/active-tab-bridge.client.spec.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it, vi } from 'vitest'
+import { activeTabBridgeConfig, createBrowserTargetBridge } from '../src/client/active-tab-bridge.ts'
+
+const parent = { postMessage: vi.fn() } as unknown as WindowProxy
+const snapshot = {
+  settings: { mode: 'pinned-tabs' as const, pinnedTabs: [{ browser: 'chrome' as const, windowId: 7, tabId: 42, url: 'https://docs.example.test/' }], primaryTabId: 42 },
+  tabs: [{ browser: 'chrome' as const, windowId: 7, tabId: 42, title: '文档', url: 'https://docs.example.test/', favIconUrl: 'https://docs.example.test/favicon.ico' }],
+  activeTab: { browser: 'chrome' as const, windowId: 7, tabId: 42, title: '文档', url: 'https://docs.example.test/', favIconUrl: 'https://docs.example.test/favicon.ico' },
+}
+
+describe('Browser Target iframe bridge', () => {
+  it('admits only the parent extension origin, matching nonce, and increasing snapshots', () => {
+    const bridge = createBrowserTargetBridge('frame-nonce', 'chrome-extension://abcdefghijklmnop')
+    const message = (overrides: object = {}) => ({
+      source: parent, origin: 'chrome-extension://abcdefghijklmnop',
+      data: { type: 'browser-target-snapshot/v1', nonce: 'frame-nonce', sequence: 1, ...snapshot, ...overrides },
+    }) as MessageEvent
+
+    expect(bridge.accept(message({ nonce: 'wrong' }), parent)).toBe(false)
+    expect(bridge.accept({ ...message(), source: null }, parent)).toBe(false)
+    expect(bridge.accept({ ...message(), origin: 'http://127.0.0.1:3080' }, parent)).toBe(false)
+    expect(bridge.source.getSnapshot()).toBeUndefined()
+    expect(bridge.accept(message(), parent)).toBe(true)
+    expect(bridge.source.getSnapshot()).toEqual(snapshot)
+    expect(bridge.accept(message(), parent)).toBe(false)
+    expect(bridge.accept(message({ sequence: 2, activeTab: { ...snapshot.activeTab, title: '新标题' } }), parent)).toBe(true)
+    expect(bridge.source.getSnapshot()?.activeTab?.title).toBe('新标题')
+  })
+
+  it('sends only whitelisted typed actions to the exact extension parent origin', () => {
+    const bridge = createBrowserTargetBridge('frame-nonce', 'chrome-extension://abcdefghijklmnop')
+    bridge.send({ command: 'set-primary', tabId: 42 }, parent)
+    expect(parent.postMessage).toHaveBeenCalledWith({
+      type: 'browser-target-command/v1', nonce: 'frame-nonce', sequence: 1, command: { command: 'set-primary', tabId: 42 },
+    }, 'chrome-extension://abcdefghijklmnop')
+  })
+
+  it('sends a nonce-bound Harness reconnect request to the exact extension parent origin', () => {
+    const bridge = createBrowserTargetBridge('frame-nonce', 'chrome-extension://abcdefghijklmnop')
+    bridge.reconnectHarness(parent)
+    expect(parent.postMessage).toHaveBeenCalledWith({
+      type: 'harness-reconnect/v1', nonce: 'frame-nonce',
+    }, 'chrome-extension://abcdefghijklmnop')
+  })
+
+  it('requires the explicit marker, nonce, and exact Chrome parent origin', () => {
+    expect(activeTabBridgeConfig({ search: '?dshBrowserTargetBridge=1&dshBrowserTargetNonce=n&dshBrowserTargetParentOrigin=chrome-extension%3A%2F%2Fabcdefghijklmnop' } as Location)).toEqual({ nonce: 'n', parentOrigin: 'chrome-extension://abcdefghijklmnop' })
+    expect(activeTabBridgeConfig({ search: '?dshBrowserTargetBridge=0&dshBrowserTargetNonce=n&dshBrowserTargetParentOrigin=chrome-extension%3A%2F%2Fabcdefghijklmnop' } as Location)).toBeUndefined()
+    expect(activeTabBridgeConfig({ search: '?dshBrowserTargetBridge=1&dshBrowserTargetNonce=n&dshBrowserTargetParentOrigin=https%3A%2F%2Fexample.com' } as Location)).toBeUndefined()
+  })
+})
