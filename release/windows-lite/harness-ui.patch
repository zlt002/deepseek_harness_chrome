@@ -0,0 +1,49 @@
+// @vitest-environment jsdom
+/** The emitted client factory must be materializable by Harness's module table. */
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+
+const PLUGIN_ID = '@deepseek-ai/dsh-session-log-export'
+
+interface Handoff {
+  readonly id: string
+  readonly factory: (require: (specifier: string) => unknown) => Record<string, unknown>
+}
+
+type Win = { __ModuleLoader__?: { load(handoff: Handoff): void } }
+
+function readBundle(): string | undefined {
+  try {
+    return readFileSync(resolve('packages/session-query/session-log-export/lib/client.js'), 'utf8')
+  } catch {
+    return undefined
+  }
+}
+
+afterEach(() => {
+  delete (window as Win).__ModuleLoader__
+})
+
+describe('tsdown client artifact', () => {
+  const code = readBundle()
+
+  it.skipIf(code === undefined)('materializes without requiring Node builtins', () => {
+    let handoff: Handoff | undefined
+    ;(window as Win).__ModuleLoader__ = { load: (value) => { handoff = value } }
+    // Deliberately execute the real generated factory wrapper, not source code.
+    // oxlint-disable-next-line typescript/no-implied-eval, typescript/no-unsafe-call
+    new Function(code!)()
+    expect(handoff?.id).toBe(PLUGIN_ID)
+
+    const platform = new Set([
+      '@deepseek-ai/dsh-client-runtime/client',
+      '@deepseek-ai/dsh-client-ui-primitives',
+      'react/jsx-runtime',
+    ])
+    expect(() => handoff!.factory((specifier) => {
+      if (platform.has(specifier)) return {}
+      throw new Error(`unexpected module-table require: ${specifier}`)
+    })).not.toThrow()
+  })
+})
