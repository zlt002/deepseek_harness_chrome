+import { describe, expect, it } from 'vitest'
+import { createKnowledgeScopeBridge } from '../src/client/bridge.ts'
+
+const parent = {} as WindowProxy
+const snapshot = { sessionId: 'child-1', scope: { domainId: 'supply', systemIds: ['order'], repositoryIds: ['repo'] }, catalog: { domains: [{ id: 'supply', name: '供应链' }], systems: [], repositories: [] } }
+
+describe('Knowledge scope iframe bridge', () => {
+  it('admits only parent-origin nonce-bound snapshots and keeps sessions isolated', () => {
+    const bridge = createKnowledgeScopeBridge('nonce', 'chrome-extension://abcdefghijklmnop')
+    const event = (overrides: object = {}) => ({ source: parent, origin: 'chrome-extension://abcdefghijklmnop', data: { type: 'knowledge-scope-snapshot/v1', nonce: 'nonce', sequence: 1, snapshot, ...overrides } }) as MessageEvent
+    expect(bridge.accept(event({ nonce: 'wrong' }), parent)).toBe(false)
+    expect(bridge.accept({ ...event(), source: null }, parent)).toBe(false)
+    expect(bridge.accept(event(), parent)).toBe(true)
+    expect(bridge.source.getSnapshot()?.sessionId).toBe('child-1')
+    expect(bridge.accept(event({ sequence: 1, snapshot: { ...snapshot, sessionId: 'other' } }), parent)).toBe(false)
+  })
+})
