@@ -0,0 +1,106 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { useMemo, useState } from 'react'
+import type { SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+import type { SettingsQuickAction } from '@deepseek-ai/dsh-client-ui-settings/client'
+import { SettingsQuickActions } from '../../ui-settings/src/client/quick-actions.ts'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import {
+  CompactSubagentHeaderActions, type CompactSubagentHeaderActionsProps,
+} from '../src/client/CompactSubagentHeaderActions.tsx'
+import { zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const CHILD = 'child' as SessionId
+const PARENT = 'parent' as SessionId
+const t = makeTranslate(zh)
+
+/** Real compact-action registry plus the conversation view state it controls. */
+function ViewHarness() {
+  const [view, setView] = useState<'chat' | 'trajectory'>('chat')
+  const quickActions = useMemo(() => {
+    const registry = new SettingsQuickActions()
+    registry.register({
+      id: 'trajectory', label: '轨迹', order: 10,
+      run: sessionId => { if (sessionId === CHILD) setView('trajectory') },
+    })
+    registry.register({
+      id: 'conversation', label: '对话', order: 11,
+      run: sessionId => { if (sessionId === CHILD) setView('chat') },
+    })
+    return registry
+  }, [])
+  const translate = ((key: string) => key === 'compact.detail.conversation'
+    ? '返回对话'
+    : t(key as never)) as CompactSubagentHeaderActionsProps['t']
+
+  return (
+    <>
+      <output data-testid="child-view">{view}</output>
+      <CompactSubagentHeaderActions
+        {...props(quickActions.store.getSnapshot())}
+        useQuickActions={selector => selector(quickActions.store.getSnapshot())}
+        useView={selector => selector(view) as never}
+        t={translate}
+      />
+    </>
+  )
+}
+
+function props(actions: readonly SettingsQuickAction[], close = vi.fn()): CompactSubagentHeaderActionsProps {
+  return {
+    sessionId: CHILD,
+    parentSessionId: PARENT,
+    useQuickActions: selector => selector(actions),
+    useView: selector => selector(null),
+    close,
+    t,
+  } as CompactSubagentHeaderActionsProps
+}
+
+describe('CompactSubagentHeaderActions', () => {
+  it('runs the existing child-scoped trajectory and raw-log actions, then returns to its direct parent', () => {
+    const trajectory = vi.fn()
+    const copyLog = vi.fn()
+    const close = vi.fn()
+    render(<CompactSubagentHeaderActions {...props([
+      { id: 'trajectory', label: '轨迹', order: 10, run: trajectory },
+      { id: 'copy-session-log', label: '复制日志', order: 20, run: copyLog },
+    ], close)} />)
+
+    fireEvent.click(screen.getByRole('button', { name: '查看轨迹' }))
+    fireEvent.click(screen.getByRole('button', { name: '复制子代理日志' }))
+    fireEvent.click(screen.getByRole('button', { name: '返回父会话' }))
+
+    expect(trajectory).toHaveBeenCalledWith(CHILD)
+    // The registered controller's copy(sessionId) sends includeDescendants=false;
+    // passing the child here is the UI boundary that keeps parent logs out.
+    expect(copyLog).toHaveBeenCalledWith(CHILD)
+    expect(close).toHaveBeenCalledWith(PARENT)
+  })
+
+  it('never invents a missing registry action, but preserves the parent-return control', () => {
+    render(<CompactSubagentHeaderActions {...props([])} />)
+    expect(screen.queryByRole('button', { name: '查看轨迹' })).toBeNull()
+    expect(screen.queryByRole('button', { name: '复制子代理日志' })).toBeNull()
+    expect(screen.getByRole('button', { name: '返回父会话' })).toBeTruthy()
+  })
+
+  it('switches a child trajectory header back to the conversation view through registered quick actions', () => {
+    render(<ViewHarness />)
+    expect(screen.getByTestId('compact-detail-trajectory-icon')).toBeTruthy()
+    expect(screen.queryByTestId('compact-detail-conversation-icon')).toBeNull()
+    fireEvent.click(screen.getByRole('button', { name: '查看轨迹' }))
+    expect(screen.getByTestId('child-view').textContent).toBe('trajectory')
+
+    // The trajectory action is now stale: the child header must expose the
+    // opposite action, whose registered run() restores this exact view state.
+    expect(screen.getByTestId('compact-detail-conversation-icon')).toBeTruthy()
+    expect(screen.queryByTestId('compact-detail-trajectory-icon')).toBeNull()
+    fireEvent.click(screen.getByRole('button', { name: '返回对话' }))
+    expect(screen.getByTestId('child-view').textContent).toBe('chat')
+    expect(screen.getByTestId('compact-detail-trajectory-icon')).toBeTruthy()
+  })
+})
