+ * descendant and an unseen completion still returns to the green reminder.
+ */
+export function SessionStateIndicator({ node, t }: { node: SessionNode; t: RowTranslate }) {
+  const statuses = sessionStatuses(node, t)
+  const primaryStatus = statuses[0]
+  const showStatus = primaryStatus.state !== 'done' || node.completed
+  if (!showStatus) return null
+  return <SessionStatusDots statuses={statuses} />
+}
+
+/** Compact localized timestamp shared by the sidebar and the header picker. */
+export function SessionTimestamp({ node, now, t }: { node: SessionNode; now: number; t: RowTranslate }) {
+  if (node.blank) return null
+  return <>{timeLabel(node.updatedAt, now, t)}</>
+}
