diff --git a/packages/client/ui-subagent/tests/compact-subagent-action.client.spec.tsx b/packages/client/ui-subagent/tests/compact-subagent-action.client.spec.tsx
new file mode 100644
index 0000000000..2eba09073d
--- /dev/null
+++ b/packages/client/ui-subagent/tests/compact-subagent-action.client.spec.tsx
@@ -0,0 +1,129 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type {
+  SessionId, SessionListState, SessionSummary, SubagentCatalogSnapshot, WorkspaceListState,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import type { CompactSubagentActionProps } from '../src/client/CompactSubagentAction.tsx'
+import { CompactSubagentAction } from '../src/client/CompactSubagentAction.tsx'
+import { zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const sid = (value: string) => value as SessionId
+const t = makeTranslate(zh)
+const summary = (id: string, running = false): SessionSummary => ({
+  id: sid(id), displayTitle: id, running, blank: false, updatedAt: 1,
+})
+const catalog = (entries: SubagentCatalogSnapshot['entries']): SubagentCatalogSnapshot => ({
+  entries, parentAvailable: true, state: 'ready', error: null,
+})
+function useSnapshot<T>(snapshot: T) {
+  return <S,>(selector: (state: T) => S): S => selector(snapshot)
+}
+function state(
+  current: SessionId | undefined,
+  summaries: readonly SessionSummary[],
+  subagentsByParent: SessionListState['subagentsByParent'],
+): SessionListState {
+  return {
+    ids: summaries.map(item => item.id),
+    byId: Object.fromEntries(summaries.map(item => [item.id, item])),
+    current,
+    phase: 'ready',
+    subagentsByParent,
+    jobsBySession: {},
+    currentAddress: undefined,
+  }
+}
+const workspaces: WorkspaceListState = {
+  items: [], archivedSessionIds: [], state: 'idle', phase: 'ready', error: null,
+  baselinesReady: true, recentWorkspaceId: undefined,
+}
+
+function props(snapshot: SessionListState, openChild = vi.fn()): CompactSubagentActionProps {
+  return {
+    useSessions: useSnapshot(snapshot),
+    useWorkspaces: useSnapshot(workspaces),
+    openChild,
+    t,
+  }
+}
+
+describe('CompactSubagentAction', () => {
+  it('counts only running direct children of the current session and opens their existing catalog address', () => {
+    const parent = sid('parent')
+    const child = sid('worker')
+    const second = sid('reviewer')
+    const inactive = sid('finished')
+    const foreign = sid('foreign')
+    const openChild = vi.fn()
+    const snapshot = state(parent, [
+      summary('parent'), summary('worker', true), summary('reviewer', true), summary('finished'), summary('foreign', true),
+    ], {
+      [parent]: catalog([
+        { kind: 'child', id: child, label: 'Research', mode: 'continuable', activity: 'running', hasChildren: false },
+        { kind: 'child', id: second, label: 'Review', mode: 'one-shot', activity: 'running', hasChildren: false },
+        { kind: 'child', id: inactive, label: 'Finished', mode: 'one-shot', activity: 'inactive', hasChildren: false },
+      ]),
+      [foreign]: catalog([
+        { kind: 'child', id: sid('foreign-child'), label: 'Other session', mode: 'one-shot', activity: 'running', hasChildren: false },
+      ]),
+    })
+    render(<CompactSubagentAction {...props(snapshot, openChild)} />)
+
+    const trigger = screen.getByRole('button', { name: '2 个运行中的子代理' })
+    expect(trigger.textContent).toContain('2')
+    fireEvent.mouseEnter(trigger)
+    expect(screen.getByRole('menu', { name: '正在运行的子代理' })).toBeTruthy()
+    expect(screen.getByRole('menuitem', { name: /Research 正在运行/ })).toBeTruthy()
+    expect(screen.getByRole('menuitem', { name: /Review 正在运行/ })).toBeTruthy()
+    expect(screen.queryByRole('menuitem', { name: /Finished/ })).toBeNull()
+    expect(screen.queryByRole('menuitem', { name: /Other session/ })).toBeNull()
+
+    fireEvent.click(screen.getByRole('menuitem', { name: /Research 正在运行/ }))
+    expect(openChild).toHaveBeenCalledWith({
+      parentSessionId: parent, childSessionId: child, mode: 'continuable',
+    })
+  })
+
+  it('does not render for inactive, mismatched-status, or another session catalog rows', () => {
+    const parent = sid('parent')
+    const other = sid('other')
+    const child = sid('worker')
+    const snapshot = state(parent, [summary('parent'), summary('worker')], {
+      [parent]: catalog([
+        { kind: 'child', id: child, label: 'Stale', mode: 'one-shot', activity: 'running', hasChildren: false },
+      ]),
+      [other]: catalog([
+        { kind: 'child', id: sid('other-worker'), label: 'Other', mode: 'one-shot', activity: 'running', hasChildren: false },
+      ]),
+    })
+    const view = render(<CompactSubagentAction {...props(snapshot)} />)
+    expect(screen.queryByRole('button')).toBeNull()
+
+    const activeOther = state(other, [summary('other'), summary('other-worker', true)], snapshot.subagentsByParent)
+    view.rerender(<CompactSubagentAction {...props(activeOther)} />)
+    expect(screen.getByRole('button', { name: '1 个运行中的子代理' })).toBeTruthy()
+  })
+
+  it('opens from focus and closes on Escape or pointer leave', () => {
+    const parent = sid('parent')
+    const snapshot = state(parent, [summary('parent'), summary('worker', true)], {
+      [parent]: catalog([
+        { kind: 'child', id: sid('worker'), label: 'Worker', mode: 'one-shot', activity: 'running', hasChildren: false },
+      ]),
+    })
+    render(<CompactSubagentAction {...props(snapshot)} />)
+    const trigger = screen.getByRole('button', { name: '1 个运行中的子代理' })
+    fireEvent.focus(trigger)
+    expect(screen.getByRole('menu')).toBeTruthy()
+    fireEvent.keyDown(trigger, { key: 'Escape' })
+    expect(screen.queryByRole('menu')).toBeNull()
+    fireEvent.mouseEnter(trigger)
+    expect(screen.getByRole('menu')).toBeTruthy()
+    fireEvent.mouseLeave(trigger.parentElement!)
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+})
