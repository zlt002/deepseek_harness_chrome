+import type { ClientContext } from '@deepseek-ai/dsh-client-runtime/client'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { KnowledgeScopeControl, KnowledgeScopePanel, type KnowledgeScopeInjected } from './KnowledgeScopeControl.tsx'
+import { createKnowledgeScopeBridge, knowledgeScopeBridgeConfig } from './bridge.ts'
+
+export const inject = ['slots']
+
+/** Mount compact scope controls above the draft and their chooser in the shared upward overlay. */
+export function apply(ctx: ClientContext): void {
+  const config = knowledgeScopeBridgeConfig()
+  if (config === undefined) return
+  const bridge = createKnowledgeScopeBridge(config.nonce, config.parentOrigin)
+  const injected = (): KnowledgeScopeInjected => ({ hooks: { knowledgeScope: bridge.source }, request: bridge.request })
+  ctx.effect(() => { const receive = (event: MessageEvent) => { bridge.accept(event, window.parent) }; window.addEventListener('message', receive); return () => window.removeEventListener('message', receive) }, 'ui-knowledge-scope: iframe bridge')
+  ctx.slots.inject('conversation.input.scope', () => ctx.slots.register({ name: 'conversation.input.scope', id: 'knowledge-scope-control', order: 20, inject: injected }, KnowledgeScopeControl))
+  ctx.slots.inject('conversation.input.overlay', () => ctx.slots.register({ name: 'conversation.input.overlay', id: 'knowledge-scope-panel', order: 20, inject: injected }, KnowledgeScopePanel))
+}
