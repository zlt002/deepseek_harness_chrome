+
+const snapshot = {
+  sessionId: 'session-1',
+  scope: { domainId: 'supply', systemIds: ['orders'], repositoryIds: ['harness'] },
+  catalog: {
+    domains: [{ id: 'supply', name: '供应链' }],
+    systems: [{ id: 'orders', name: '订单知识库' }],
+    repositories: [{ id: 'harness', name: 'Harness' }],
