@@ -0,0 +1,86 @@
+// @vitest-environment jsdom
+import { Context } from '@deepseek-ai/cordis'
+import { SlotRegistry, createSnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { BrowserTargetControl, BrowserTargetPanel } from '../src/client/BrowserTargetControl.tsx'
+import { HarnessReconnectAction } from '../src/client/HarnessReconnectAction.tsx'
+import { apply, inject } from '../src/client/index.ts'
+
+afterEach(cleanup)
+
+const snapshot = {
+  settings: { mode: 'pinned-tabs' as const, pinnedTabs: [{ browser: 'chrome' as const, windowId: 1, tabId: 2, url: 'https://docs.example.test/' }], primaryTabId: 2 },
+  tabs: [{ browser: 'chrome' as const, windowId: 1, tabId: 2, title: '产品文档', url: 'https://docs.example.test/' }],
+}
+
+describe('BrowserTargetControl', () => {
+  it('renders the compact Harness reconnect action with an accessible Chinese label', () => {
+    const reconnectHarness = vi.fn()
+    render(<HarnessReconnectAction {...({ reconnectHarness } as Parameters<typeof HarnessReconnectAction>[0])} />)
+    fireEvent.click(screen.getByRole('button', { name: '重新连接 Harness' }))
+    expect(reconnectHarness).toHaveBeenCalledOnce()
+  })
+
+  it('keeps the Browser Target action visible while the first iframe snapshot is still pending', () => {
+    const source = createSnapshotStore<undefined>(undefined)
+    const panel = createSnapshotStore(false)
+    const props = {
+      useBrowserTarget: (selector: (value: undefined) => unknown) => selector(source.getSnapshot()),
+      useBrowserTargetPanel: (selector: (value: boolean) => unknown) => selector(panel.getSnapshot()),
+      onBrowserTargetCommand: () => {},
+      onBrowserTargetPanelChange: (open: boolean) => panel.set(open),
+    } as unknown as Parameters<typeof BrowserTargetControl>[0]
+    render(<BrowserTargetControl {...props} />)
+    expect(screen.getByLabelText('工作目标上下文：正在读取浏览器标签页')).not.toBeNull()
+  })
+
+  it('keeps the compact action in the input row and exposes the selected target in its panel', () => {
+    const source = createSnapshotStore(snapshot)
+    const panel = createSnapshotStore(false)
+    const props = {
+      useBrowserTarget: (selector: (value: typeof snapshot) => unknown) => selector(source.getSnapshot()),
+      useBrowserTargetPanel: (selector: (value: boolean) => unknown) => selector(panel.getSnapshot()),
+      onBrowserTargetCommand: () => {},
+      onBrowserTargetPanelChange: (open: boolean) => panel.set(open),
+    } as unknown as Parameters<typeof BrowserTargetControl>[0]
+    const { rerender } = render(<BrowserTargetControl {...props} />)
+    const trigger = screen.getByLabelText('工作目标上下文：固定选中标签，当前绑定 产品文档，共 1 个')
+    fireEvent.click(trigger)
+    expect(panel.getSnapshot()).toBe(true)
+    rerender(<BrowserTargetPanel {...props as unknown as Parameters<typeof BrowserTargetPanel>[0]} />)
+    expect(screen.getByRole('dialog', { name: '工作目标上下文' })).not.toBeNull()
+    expect(screen.getAllByRole('radio').map(node => node.textContent)).toEqual(['跟随当前目标', '固定选中标签', '不绑定目标'])
+    expect(screen.getByText('产品文档')).not.toBeNull()
+    expect(screen.getByText('主目标')).not.toBeNull()
+  })
+
+  it('registers only the composer action and overlay for an explicitly marked extension iframe', async () => {
+    expect(inject).toEqual(['slots'])
+    const ctx = new Context()
+    await ctx.plugin(SlotRegistry).await()
+    ctx.slots.register({
+      name: 'root', children: {
+        'conversation.input.left': { kind: 'list', scope: 'session' },
+        'conversation.input.overlay': { kind: 'list', scope: 'session' },
+        'sidebar': { kind: 'single', scope: 'root' },
+      },
+    } as never, (() => null) as never)
+    ctx.slots.register({
+      name: 'sidebar', children: { 'sidebar.compact.action': { kind: 'list', scope: 'root' } },
+    } as never, (() => null) as never)
+    const unmarked = ctx.plugin({ inject: [...inject], apply })
+    await unmarked.await()
+    expect(ctx.slots.entries('conversation.input.left')).toHaveLength(0)
+    await unmarked.dispose()
+
+    history.replaceState(null, '', '/?dshBrowserTargetBridge=1&dshBrowserTargetNonce=frame-nonce&dshBrowserTargetParentOrigin=chrome-extension%3A%2F%2Fabcdefghijklmnop')
+    const marked = ctx.plugin({ inject: [...inject], apply })
+    await marked.await()
+    expect(ctx.slots.entries('conversation.input.left')[0]?.options).toMatchObject({ id: 'browser-target-control', order: 10 })
+    expect(ctx.slots.entries('conversation.input.overlay')[0]?.options).toMatchObject({ id: 'browser-target-panel', order: 10 })
+    expect(ctx.slots.entries('sidebar.compact.action')[0]?.options).toMatchObject({ id: 'harness-reconnect', order: 10 })
+    await marked.dispose()
+    history.replaceState(null, '', '/')
+  })
+})
