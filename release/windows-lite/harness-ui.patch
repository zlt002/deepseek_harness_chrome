+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+const rootCss = readFileSync(fileURLToPath(new URL('../src/client/skeleton/ConversationRoot.module.css', import.meta.url)), 'utf8')
+const inputCss = readFileSync(fileURLToPath(new URL('../src/client/skeleton/InputBar.module.css', import.meta.url)), 'utf8')
+
+describe('hero composer layout', () => {
+  it('keeps the hero composer in the root footer while the body above it scrolls', () => {
+    expect(rootCss).toMatch(/\.root\[data-phase='hero'\] \.scrollBody\s*\{[\s\S]*?justify-content:\s*flex-end;/)
+    expect(inputCss).toMatch(/\.hero\s*\{[\s\S]*?padding:\s*0 var\(--dsh-composer-side-clearance\) 8px;/)
+    expect(rootCss).toMatch(/\.scrollBody\s*\{[\s\S]*?flex:\s*1;[\s\S]*?min-height:\s*0;[\s\S]*?overflow-y:\s*auto;/)
+  })
+
+  it('contains upward overscroll in the session scrollport', () => {
+    // jsdom cannot emulate Chromium's rubber-band scroll chaining. Keep the
+    // production scrollport selector in this contract test instead: when the
+    // user reaches scrollTop = 0, this declaration is what prevents the wheel
+    // gesture from escaping into the sidepanel document.
+    expect(rootCss).toMatch(/\.scrollBody\s*\{[\s\S]*?overscroll-behavior-y:\s*contain;/)
+  })
+})
