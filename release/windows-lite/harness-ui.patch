+import { useEffect } from 'react'
+import type { InjectFace, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { useComposerOverlay } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { Catalog, Scope, Snapshot } from './bridge.ts'
+import css from './KnowledgeScopeControl.module.css'
+
+export interface KnowledgeScopeInjected { hooks: { knowledgeScope: SnapshotStore<Snapshot | undefined> }; request: (sessionId: string, scope?: Scope) => void }
+type ControlProps = PropsRuntime<'conversation.input.scope'> & InjectFace<KnowledgeScopeInjected>
+type PanelProps = PropsRuntime<'conversation.input.overlay'> & InjectFace<KnowledgeScopeInjected>
+const emptyCatalog: Catalog = { domains: [], systems: [], repositories: [] }
+const scopeFor = (snapshot: Snapshot | undefined, sessionId: string) => snapshot?.sessionId === sessionId ? snapshot.scope : undefined
+
+/** Compact scope strip above the composer draft. */
+export function KnowledgeScopeControl({ session, useKnowledgeScope, request }: ControlProps) {
+  const snapshot = useKnowledgeScope(value => value)
+  const overlay = useComposerOverlay('knowledge-scope')
+  const sessionId = String(session.sessionId)
+  useEffect(() => { request(sessionId) }, [request, sessionId])
+  const catalog = snapshot?.catalog ?? emptyCatalog
+  const scope = scopeFor(snapshot, sessionId)
+  const repositories = scope?.repositoryIds ?? []
+  const repositoriesEnabled = repositories.length > 0
+  const repositoryValue = repositories.length === 0 ? '__none__' : repositories.length === 1 ? repositories[0] : '__all__'
+  const update = (next: Scope) => request(sessionId, next)
+  const domainName = catalog.domains.find(item => item.id === scope?.domainId)?.name ?? '知识范围'
+  return <div className={css.strip} aria-label="知识检索范围">
+    <button className={css.repositoryToggle} type="button" role="switch" aria-checked={repositoriesEnabled} onClick={() => update({ domainId: scope?.domainId ?? '', systemIds: scope?.systemIds ?? [], repositoryIds: repositoriesEnabled ? [] : catalog.repositories.map(item => item.id) })}><span aria-hidden className={css.switchTrack}><span /></span>代码库</button>
+    <select className={css.compactSelect} aria-label="选择代码库" disabled={!repositoriesEnabled} value={repositoryValue} onChange={(event) => update({ domainId: scope?.domainId ?? '', systemIds: scope?.systemIds ?? [], repositoryIds: event.target.value === '__all__' ? catalog.repositories.map(item => item.id) : event.target.value === '__none__' ? [] : [event.target.value] })}>
+      <option value="__none__">选择代码库</option><option value="__all__">全部代码库</option>{catalog.repositories.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}
+    </select>
+    <button className={css.scopeTrigger} type="button" aria-label={`知识范围：${domainName}`} aria-expanded={overlay.open} data-composer-overlay-trigger onMouseDown={(event) => event.preventDefault()} onClick={overlay.toggle}>▤ {domainName}</button>
+  </div>
+}
+
+function KnowledgeScopePanelBody({ sessionId, useKnowledgeScope, request }: PanelProps) {
+  const snapshot = useKnowledgeScope(value => value)
+  const id = String(sessionId)
+  const catalog = snapshot?.catalog ?? emptyCatalog
+  const scope = scopeFor(snapshot, id)
+  const update = (next: Scope) => request(id, next)
+  return <div className={css.panel} role="dialog" aria-label="知识范围">
+    <div className={css.row}><b>领域</b><select className={css.select} value={scope?.domainId ?? ''} onChange={(event) => update({ domainId: event.target.value, systemIds: [], repositoryIds: [] })}><option value="">选择领域</option>{catalog.domains.map(item => <option key={item.id} value={item.id}>{item.name}</option>)}</select></div>
+    {scope !== undefined && <><div className={css.row}><b>知识库系统</b><span className={css.checks}>{catalog.systems.map(item => <label key={item.id}><input type="checkbox" checked={scope.systemIds.includes(item.id)} onChange={(event) => update({ ...scope, systemIds: event.target.checked ? [...scope.systemIds, item.id] : scope.systemIds.filter(id => id !== item.id) })}/>{item.name}</label>)}</span></div>
+      <div className={css.row}><b>代码库</b><span className={css.checks}>{catalog.repositories.map(item => <label key={item.id}><input type="checkbox" checked={scope.repositoryIds.includes(item.id)} onChange={(event) => update({ ...scope, repositoryIds: event.target.checked ? [...scope.repositoryIds, item.id] : scope.repositoryIds.filter(id => id !== item.id) })}/>{item.name}</label>)}</span></div>
+      <p className={css.hint}>查询由持续知识子代理执行；范围不会进入提示词。</p></>}
+  </div>
+}
+
+/** Registers the full selector with InputBar's existing upward overlay surface. */
+export function KnowledgeScopePanel(props: PanelProps) {
+  const overlay = useComposerOverlay('knowledge-scope', <KnowledgeScopePanelBody {...props} />)
+  return overlay.available ? null : overlay.open ? <KnowledgeScopePanelBody {...props} /> : null
+}
