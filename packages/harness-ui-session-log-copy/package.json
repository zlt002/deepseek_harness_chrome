{
  "name": "@accrui/harness-ui-session-log-copy",
  "version": "0.1.0",
  "private": true,
  "description": "Out-of-tree AccrUI copy-current-session-log action for Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/client.js.map"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-session-log-export"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node ../../scripts/build/build-harness-client-plugins.mjs harness-ui-session-log-copy",
    "typecheck": "node ../../scripts/build/build-harness-client-plugins.mjs harness-ui-session-log-copy",
    "test": "node --test test/*.test.mjs"
  }
}
