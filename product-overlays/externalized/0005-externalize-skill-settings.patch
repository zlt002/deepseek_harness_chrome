-/** Skill management page with one durable, Harness-local mode per skill. */
-import { useEffect, useState } from 'react'
-import type { ReactNode } from 'react'
-import type { IApiClient, SkillEntry } from '@deepseek-ai/dsh-api-remotes/client'
-import type { SessionListState } from '@deepseek-ai/dsh-client-runtime/client'
-import type { SnapshotSelectorHook } from '@deepseek-ai/dsh-client-web-react'
-import type { en } from './locales.ts'
-import css from './SkillSettingsSection.module.css'
-
-const SETTINGS_NAMESPACE = 'skill-settings'
-type Mode = 'enabled' | 'manual-only' | 'disabled'
-
-export interface SkillSettingsInjected {
-  readonly api: Pick<IApiClient, 'skills' | 'settings'>
-  readonly t: (key: keyof typeof en) => string
-  readonly useSessions: SnapshotSelectorHook<SessionListState>
-}
-
-export type SkillSettingsProps = Partial<SkillSettingsInjected>
-
-interface View {
-  readonly writable: boolean
-  readonly revision: number
-  readonly modes: Record<string, Mode>
-  readonly skills: readonly SkillEntry[]
-}
-
-function modeOf(view: View, name: string): Mode { return view.modes[name] ?? 'enabled' }
-
-function modesOf(value: unknown): Record<string, Mode> {
-  if (typeof value !== 'object' || value === null || Array.isArray(value)) return {}
-  const modes = (value as { modes?: unknown }).modes
-  if (typeof modes !== 'object' || modes === null || Array.isArray(modes)) return {}
-  return Object.fromEntries(Object.entries(modes).filter((entry): entry is [string, Mode] =>
-    entry[1] === 'enabled' || entry[1] === 'manual-only' || entry[1] === 'disabled'))
-}
-
-/** Render the per-project Skill management page. */
-export function SkillSettingsSection(props: SkillSettingsProps): ReactNode {
-  const { api, t, useSessions } = props
-  if (api === undefined || t === undefined || useSessions === undefined) return null
-  return <Loaded api={api} t={t} useSessions={useSessions} />
-}
-
-/** Render only after the slot has supplied every injected dependency. */
-function Loaded({ api, t, useSessions }: SkillSettingsInjected): ReactNode {
-  const sessionId = useSessions(state => state.current)
-  const [view, setView] = useState<View | undefined>()
-  const [failure, setFailure] = useState(false)
-  const [pending, setPending] = useState<string | undefined>()
-  const [request, setRequest] = useState(0)
-
-  useEffect(() => {
-    let current = true
-    if (sessionId === undefined) {
-      setView(undefined)
-      setFailure(false)
-      return () => { current = false }
-    }
-    setFailure(false)
-    void Promise.all([api.skills.list({ sessionId, includeUnavailable: true }), api.settings.describe({})]).then(
-      ([catalog, settings]) => {
-        if (!current) return
-        if (!catalog.result.ok || !settings.result.ok) { setFailure(true); return }
-        const section = settings.result.value.namespaces.find(item => item.ns === SETTINGS_NAMESPACE)
-        if (section === undefined) { setFailure(true); return }
-        setView({ writable: settings.result.value.writable, revision: section.revision, modes: modesOf(section.value), skills: catalog.result.value.skills })
-      },
-      () => { if (current) setFailure(true) },
-    )
-    return () => { current = false }
-  }, [api, request, sessionId])
-
-  const change = (skill: SkillEntry, next: Mode): void => {
-    if (view === undefined || pending !== undefined || !view.writable) return
-    setPending(skill.name)
-    void api.settings.update({
-      ns: SETTINGS_NAMESPACE,
-      patch: { modes: { [skill.name]: next } },
-      expectedRevision: view.revision,
-    }).then((response) => {
-      if (!response.result.ok) { setFailure(true); return }
-      setRequest(value => value + 1)
-    }, () => { setFailure(true) }).finally(() => { setPending(undefined) })
-  }
-
-  if (sessionId === undefined) return <p className={css.status}>{t('noSession')}</p>
-  if (failure) return <div className={css.status}><p role="alert">{view === undefined ? t('loadFailed') : t('saveFailed')}</p><button type="button" onClick={() => setRequest(value => value + 1)}>{t('retry')}</button></div>
-  if (view === undefined) return <p className={css.status}>{t('loading')}</p>
-  return <section className={css.section}>
-    <h2>{t('title')}</h2><p className={css.intro}>{t('intro')}</p>
-    {view.skills.length === 0 ? <p className={css.status}>{t('empty')}</p> : <ul className={css.rows}>
-      {view.skills.map(skill => {
-        const mode = modeOf(view, skill.name)
-        const disabled = pending !== undefined || !view.writable
-        return <li key={skill.name} className={css.row}>
-          <div><strong>{skill.name}</strong><p>{skill.description}</p>
-            {skill.authoredModelInvocable === false ? <span>{t('authoredModelOff')}</span> : null}
-            {skill.authoredUserInvocable === false ? <span>{t('authoredUserOff')}</span> : null}
-          </div>
-          <select aria-label={skill.name} value={mode} disabled={disabled} onChange={event => change(skill, event.currentTarget.value as Mode)}>
-            <option value="enabled">{t('enabled')}</option><option value="manual-only">{t('manualOnly')}</option><option value="disabled">{t('disabled')}</option>
-          </select>
-        </li>
-      })}
-    </ul>}
-  </section>
-}
