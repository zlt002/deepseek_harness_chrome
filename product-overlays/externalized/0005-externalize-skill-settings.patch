-import { SkillRegistry } from '@deepseek-ai/dsh-skill'
-import { MemorySettings } from '../../../settings/settings/tests/memory.ts'
-import { apply, SETTINGS_NAMESPACE } from '../src/index.ts'
-
-describe('skill-settings', () => {
-  it('persists modes and intersects them with authored invocation controls', async () => {
-    const ctx = new Context()
-    await ctx.plugin(SkillRegistry)
-    await ctx.plugin(MemorySettings)
-    await ctx.plugin({ inject: ['skills'], apply })
-    ctx.skills.register({
-      name: 'shared-skill', description: 'Both surfaces', source: 'runtime', content: 'shared',
-    })
-    ctx.skills.register({
-      name: 'author-user-hidden', description: 'Author-hidden user surface', source: 'runtime', content: 'hidden',
-      invocation: { modelInvocable: true, userInvocable: false },
-    })
-
-    await ctx.settings.update(SETTINGS_NAMESPACE, {
-      modes: { 'shared-skill': 'manual-only', 'author-user-hidden': 'enabled' },
-    })
-
-    const effective = await ctx.skills.list()
-    expect(effective.find(skill => skill.name === 'shared-skill')?.invocation)
-      .toEqual({ modelInvocable: false, userInvocable: true })
-    // Local enabled may not widen an author-owned frontmatter denial.
-    expect(effective.find(skill => skill.name === 'author-user-hidden')?.invocation)
-      .toEqual({ modelInvocable: true, userInvocable: false })
-    expect((await ctx.skills.get('shared-skill'))?.invocation)
-      .toEqual({ modelInvocable: false, userInvocable: true })
-    // The settings page can still inspect and re-enable a disabled skill.
-    expect((await ctx.skills.listSource()).find(skill => skill.name === 'shared-skill')?.invocation)
-      .toEqual({ modelInvocable: true, userInvocable: true })
-  })
-
-  it('removes both entry points for disabled without touching the source catalog', async () => {
-    const ctx = new Context()
-    await ctx.plugin(SkillRegistry)
-    await ctx.plugin(MemorySettings)
-    await ctx.plugin({ inject: ['skills'], apply })
-    ctx.skills.register({ name: 'pause-me', description: 'Pause', source: 'runtime', content: 'pause' })
-    await ctx.settings.update(SETTINGS_NAMESPACE, { modes: { 'pause-me': 'disabled' } })
-
-    expect((await ctx.skills.list())[0]?.invocation).toEqual({ modelInvocable: false, userInvocable: false })
-    expect((await ctx.skills.get('pause-me'))?.invocation).toEqual({ modelInvocable: false, userInvocable: false })
-    expect((await ctx.skills.listSource())[0]?.invocation).toEqual({ modelInvocable: true, userInvocable: true })
-  })
-})
