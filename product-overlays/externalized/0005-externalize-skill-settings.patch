-/**
- * Harness-local Skill invocation settings.
- *
- * This plugin keeps user choices in the Harness settings document and projects
- * them through the skill registry. It never writes a provider's SKILL.md.
- * @module @deepseek-ai/dsh-skill-settings
- */
-
-import type { Context } from '@deepseek-ai/cordis'
-import z from '@deepseek-ai/schemastery'
-import {
-  settingsNamespace,
-  type SettingsScope,
-} from '@deepseek-ai/dsh-settings'
-import type { SkillInvocationPolicy, SkillSummary } from '@deepseek-ai/dsh-skill'
-
-export const name = 'skill-settings'
-export const inject = ['skills']
-
-/** Settings document namespace owned by this plugin. */
-export const SETTINGS_NAMESPACE = settingsNamespace('skill-settings')
-
-/** Harness-local visibility choices for an otherwise discovered skill. */
-export type SkillSettingMode = 'enabled' | 'manual-only' | 'disabled'
-
-/** Durable settings document shape. Names absent from modes inherit enabled. */
-export interface SkillSettingsConfig {
-  readonly modes: Record<string, SkillSettingMode>
-}
-
-/** Validate the small durable setting map. */
-export const Config: z<SkillSettingsConfig> = z.object({
-  modes: z.dict(z.union(['enabled', 'manual-only', 'disabled'])).default({}),
-})
-
-/** Resolve the requested Harness-local controls for one mode. */
-export function invocationForMode(mode: SkillSettingMode): SkillInvocationPolicy {
-  switch (mode) {
-    case 'enabled': return { modelInvocable: true, userInvocable: true }
-    case 'manual-only': return { modelInvocable: false, userInvocable: true }
-    case 'disabled': return { modelInvocable: false, userInvocable: false }
-  }
-}
-
-/** Resolve a setting mode, with new skills enabled until the user changes them. */
-export function modeFor(config: SkillSettingsConfig, skill: Pick<SkillSummary, 'name'>): SkillSettingMode {
-  return config.modes[skill.name] ?? 'enabled'
-}
-
-/**
- * Register the durable local policy. The registry intersects this answer with
- * frontmatter, so choosing enabled cannot re-enable an author-disabled entry.
- * @param ctx - Host context with the skill registry.
- */
-export function apply(ctx: Context): void {
-  let settings: SkillSettingsConfig = { modes: {} }
-  ctx.effect(() => ctx.skills.registerInvocationPolicy({
-    resolve(skill) {
-      return invocationForMode(modeFor(settings, skill))
-    },
-  }), 'skill-settings invocation policy')
-
-  ctx.inject(['settings'], (settingsCtx) => {
-    const scope: SettingsScope<SkillSettingsConfig> = settingsCtx.settings.register(SETTINGS_NAMESPACE, Config)
-    const publish = (next: SkillSettingsConfig): void => {
-      settings = next
-      ctx.skills.invalidateInvocationPolicy()
-    }
-    publish(scope.get())
-    scope.watch((next) => { publish(next) })
-  })
-}
