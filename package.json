{
  "name": "deepseek_harness_chrome",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness browser extension shell with a Native Messaging backend.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "verify:upstream": "node scripts/checks/verify-upstream-clean.mjs",
    "materialize:harness-product": "node scripts/build/materialize-harness-product.mjs",
    "build:harness-product": "node scripts/build/materialize-harness-product.mjs --build",
    "build:harness-client-plugins": "node scripts/build/build-harness-client-plugins.mjs",
    "sync-harness-assets": "node scripts/build/sync-harness-assets.mjs",
    "dev": "pnpm build:harness-client-plugins && pnpm sync-harness-assets && node scripts/dev/prepare-dev-port.mjs && pnpm --dir apps/chrome-extension run dev",
    "build": "pnpm build:harness-client-plugins && pnpm sync-harness-assets && pnpm --dir apps/chrome-extension run build",
    "zip": "pnpm build:harness-client-plugins && pnpm sync-harness-assets && pnpm --dir apps/chrome-extension run zip",
    "release:windows-lite": "pnpm build && node release/windows-lite/windows-release.mjs",
    "release:windows-lite:mac": "node release/windows-lite/build-with-native-assets.mjs",
    "release:mac-production-poc": "node release/mac-lite/build-mac-production.mjs",
    "materialize:windows-native-assets": "node release/windows-lite/materialize-windows-native-assets.mjs",
    "materialize:windows-harness-static-runtime": "node release/windows-lite/build-static-harness-runtime.mjs",
    "materialize:windows-harness-runtime": "node release/windows-lite/materialize-harness-runtime.mjs",
    "test:windows-release": "node --test test/windows-release.test.mjs",
    "test:windows-runtime": "node --test test/materialize-harness-runtime.test.mjs",
    "typecheck": "pnpm --dir apps/chrome-extension run typecheck",
    "typecheck:plugins": "node scripts/checks/run-product-plugin-command.mjs typecheck",
    "test:plugins": "node scripts/checks/run-product-plugin-command.mjs test",
    "pretest": "node scripts/checks/prepare-test-runtime.mjs",
    "test": "node --test test/*.test.mjs && pnpm test:plugins",
    "register-native-host": "node scripts/native/register-native-host.mjs",
    "dev:restart": "node scripts/dev/restart-dev.mjs",
    "dev:watch": "node scripts/dev/watch-dev.mjs",
    "dev:refresh": "node scripts/dev/refresh-dev.mjs",
    "dev:setup:windows": "pnpm install --frozen-lockfile && pnpm build:harness-product && pnpm register-native-host"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "esbuild": "0.27.7",
    "js-yaml": "4.1.0",
    "typescript": "^5.9.2"
  }
}
